#!/usr/bin/env bash
# Launch gBASIC Studio.
#
#   ./studio [mode] [home] [folder]          the window by default (`gui`/`qt`)
#   ./studio shoot <script> <out-dir>        a book figure from a shot script
#   ./studio mcp [home|-] [folder]           Studio over MCP on stdin/stdout
#
# The interpreter and stdlib default to a sibling gBASIC checkout and both are
# overridable:
#
#   GBASIC=/usr/local/bin/gbasic GBASIC_STDLIB=/usr/local/share/gbasic/stdlib ./studio
#
# Every decision -- the entry point, the environment, a figure's fresh home --
# is gBASIC's, in lib/studio_launch.bas, shared with studio.cmd on Windows.
# This stub only finds an interpreter and EXECS the plan app/launch.bas prints,
# so Ctrl+C and the exit status reach Studio exactly as before. (gBASIC has no
# exec, and a child it starts sits in a process group of its own, which a
# terminal's Ctrl+C does not reach.)
set -u
# Remembered before the cd: a path the user typed is relative to where THEY are.
export GBASIC_STUDIO_CWD="$PWD"
cd "$(dirname "$0")" || exit 1
GBASIC="${GBASIC:-../gbasic/gbasic}"
if [ ! -x "$GBASIC" ]; then
    printf 'no gbasic interpreter at %s\n' "$GBASIC" >&2
    printf 'set GBASIC=/path/to/gbasic (and GBASIC_STDLIB=/path/to/stdlib)\n' >&2
    exit 1
fi
export GBASIC
plan="$(GBASIC_PATH=lib "$GBASIC" app/launch.bas --plan-sh "$@")" || exit $?
eval "$plan"
