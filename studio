#!/usr/bin/env bash
# Launch gBASIC Studio.
#
# Studio is written in gBASIC but is not the gBASIC project, so it has to be told
# where the interpreter and its standard library are. Both default to a sibling
# checkout and both are overridable:
#
#   GBASIC=/usr/local/bin/gbasic GBASIC_STDLIB=/usr/local/share/gbasic/stdlib ./studio
#
# Usage:  ./studio [mode] [home] [folder]
#   mode    defaults to `gui` (opens a window; needs GTK 4 and a display)
#   home    where Studio keeps its workspace, session and settings
#           (defaults to ~/.gbasic-studio, created on first run)
#   folder  gui mode only: an existing directory to open as a project, e.g.
#             ./studio gui ~/.gbasic-studio ~/development/myproject
set -u
# Remembered before the cd, because a folder argument the user typed is relative
# to where THEY are, not to where Studio lives.
orig_pwd="$PWD"
cd "$(dirname "$0")"

GBASIC="${GBASIC:-../gbasic/gbasic}"
GBASIC_STDLIB="${GBASIC_STDLIB:-../gbasic/stdlib}"

if [ ! -x "$GBASIC" ]; then
    printf 'no gbasic interpreter at %s\n' "$GBASIC" >&2
    printf 'set GBASIC=/path/to/gbasic (and GBASIC_STDLIB=/path/to/stdlib)\n' >&2
    exit 1
fi
if [ ! -d "$GBASIC_STDLIB" ]; then
    printf 'no gBASIC stdlib at %s\n' "$GBASIC_STDLIB" >&2
    printf 'Studio needs persist, filetree, gtk, sourceeditor and gi from it\n' >&2
    exit 1
fi

mode="${1:-gui}"
home="${2:-$HOME/.gbasic-studio}"
folder="${3:-}"
case "$folder" in
    ""|/*) ;;
    *) folder="$orig_pwd/$folder" ;;
esac

export GBASIC
# Where the USER was when they ran this, which is not where Studio runs. The cd
# above moves into the install tree, so a relative path typed into the window's
# name field would otherwise resolve against Studio's own source — the one
# answer that is never what anyone meant. The third argument below already gets
# this treatment; the field needs the same referent.
export GBASIC_STUDIO_CWD="$orig_pwd"
export GBASIC_PATH="lib:$GBASIC_STDLIB"
# The window asks for its icon by name (org.gbasic.Studio). Adding an icon
# directory at run time would need Gtk.IconTheme.get_for_display, a class static
# the gi bridge cannot resolve, so the path is supplied from out here instead:
# GTK reads XDG_DATA_DIRS for icon themes at startup, and share/ holds both the
# hicolor icon and the .desktop entry. An installed copy needs none of this.
export XDG_DATA_DIRS="$PWD/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# STU-8: a library ships viewer metadata for its own types beside itself, so the
# registry has to know where the stdlib is -- and where Studio's bundled copies
# are, since a stock install has no library-shipped sidecar yet.
export GBASIC_STDLIB
export GBASIC_STUDIO_VIEWERS="$PWD/viewers"
# STU-12: New Project can write a LICENSE, and Studio does not author one -- it
# copies the text out of share/licenses/. An installed copy keeps share/
# somewhere else, and Studio's own working directory is never the answer, so the
# location is supplied from out here like the viewer registry above.
export GBASIC_STUDIO_SHARE="$PWD/share"
# Only pass a third argument when there is one: several modes read args[2] as
# their own parameter, and handing them an empty string is not the same as
# handing them nothing.
if [ -n "$folder" ]; then
    exec "$GBASIC" app/studio.bas "$mode" "$home" "$folder"
fi
exec "$GBASIC" app/studio.bas "$mode" "$home"
