-- a malformed key is refused rather than padded or hashed into shape
  "" -> usable: false
  "short" -> usable: false
  "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeZZ" -> usable: false
  "00112233445566778899aabbccddeeff00112233445566778899aabbccddee" -> usable: false

-- a 64-hex key is usable, in either case
  lower: true
  upper: true

-- storing without a key REFUSES. It does not fall back to plaintext:
   a store that silently degrades is worse than none, because the user
   believes the first thing they were told.
  ok=false — no key: set GBASIC_STUDIO_SECRET_KEY to a 64-character hex key
  a file was written: false

-- and the state is one word, so no caller has to infer it
  locked
