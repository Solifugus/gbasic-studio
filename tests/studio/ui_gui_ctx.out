right-click a FILE row (through a real y, not an index)
  menu: open,rename,delete
  the popover is up=true
  selection followed the click=.../main.bas
right-click a DIRECTORY row
  menu: new-file-here,new-folder-here,rename,delete
right-click the PROJECT row
  menu: project-file,close-project
right-click the workspace INFO row
  menu: (no menu)
-- Rename fills the field rather than renaming --
  name field=[main.bas] status=type the new name in the field, then press Rename
  main.bas is still called main.bas=true
-- Delete arms, exactly as the toolbar button does --
  status=delete main.bas? — click Delete again to confirm
  main.bas is still there=true
-- Add project file, on the project that was right-clicked --
  active before=proj-1
  status=wrote .../.gstudio.json
  active after=proj-1
  Beta got the file=true
-- Close project --
  status=closed Alpha — the folder is untouched
