-- reading the file decoded NO rows: they are strings until asked for
  [700][1] = row 700   decoded: 1
  [700][2] = 1050   decoded: 1 (cached; the row was not decoded twice)
  [3][0] = 3     decoded: 2

-- a capped export knows it is capped
