registry: 4 viewer(s) from 1 source(s)
  stats <- 4 viewer(s)
  regression matches record with coefficients, std_errors, t_values, p_values, r_squared
  logit matches record with coefficients, std_errors, z_values, p_values, pseudo_r2, link
  ttest matches record with statistic, df, p_value, se
  confidence_interval matches record with mean, lower, upper, margin, level

-- the capture rules the epilogue is compiled from (most specific first)
  logit: needs 6, fetches n, link, pseudo_r2, log_likelihood, aic, converged, coefficients, std_errors, z_values, p_values
  regression: needs 5, fetches n, r_squared, adj_r_squared, df, coefficients, std_errors, t_values, p_values
  confidence_interval: needs 5, fetches level, mean, lower, upper, margin, df
  ttest: needs 4, fetches statistic, df, p_value, se, mean, mean1, mean2
