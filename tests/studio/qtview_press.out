-- the name field is where every naming action reads from --
  typed: from_the_menu.bas
-- a browser row SELECTED, which does not activate --
  action: selected | ready — workspace — 1 project(s) — 0 open
-- New File, from the menu --
  action: created | created from_the_menu.bas
  the field was consumed: []
-- Delete Selected still arms, and the arm is keyed to the file --
  first:  armed | delete from_the_menu.bas? — click Delete again to confirm
  second: deleted | deleted from_the_menu.bas
-- the theme, which is a CHECKABLE action and not a glyph --
  action: theme-set
  dark checked:   true
  system checked: false
  pressing it again is not a change:
    theme-same
-- the editor's text size, on the ladder --
  text-bigger   zoom-set 115%
  text-bigger   zoom-set 130%
  text-smaller  zoom-set 115%
  text-reset    zoom-set 100%
-- Reload, which is about the FILES and not the window --
  action: refreshed
-- Save with nothing open refuses by name --
  action: none | nothing selected
-- Run, and the CARET is what picks the section --
-- typing into a clean file, and the poller leaves it typed --
  editor over four ticks: [x] [x] [x] [x]
  title: * main.bas — gBASIC Studio — workspace
  caret at line 1 — strip says: section: sec-2 function one
  caret at line 6 — strip says: section: sec-3 function two
  and the caret reads back 1-based: line=6 column=3 selecting=false
  Run answered: running (sec-3)
  status: running sec-3
  a line past the end is refused, as it should be
  stopped: stopping
-- a tab's own right-click menu acts on the tab CLICKED --
  the menu holds: Close, Copy file path
  right-clicked untitled-1.bas: shown=true, about the clicked one=true
  Copy file path: copied-path | clipboard holds that file=true
  status names the whole path: true
  the active tab did not move: true
  Close on the unsaved tab: armed-close, still open=true
  Close on untitled-1.bas: closed, tabs 2 -> 1, active still the same=true
-- the text size reaches the EDITOR, not just the setting --
  text-bigger   115% -> the editor is at 115%
  text-bigger   130% -> the editor is at 130%
  text-smaller  115% -> the editor is at 115%
  text-reset    100% -> the editor is at 100%
  a tab opened at 115%: zoomed.bas is at 115%
  shortcuts: Ctrl++ / Ctrl+- / Ctrl+0
-- the browser's own right-click menu, per row --
  file    shown=true offers: open, rename, delete
  dir     shown=true offers: open, rename, delete
  project shown=true offers: open, rename, delete
  info    shown=true offers: open, rename, delete
  (an all-hidden menu is not shown, which is Qt refusing rather
   than us: an empty one reads as a control that failed)
-- Rename from that menu FILLS the field and does not rename --
  action: rename-ready
  raised on a file, and the field holds that row: true
  field is a file in the project: true
-- New Project opens its own window, filled and pressed for real --
  open:     true
  name:     [Project 2]
  main.bas ticked by default: true
  .gstudio.json is NOT:       false
  (a box you had to untick is not consent)
  a second press presents the one that is open, not a second:
    still one window: true
-- a refusal keeps the window open, with what was typed in it --
  note:     give the project a name
  open:     true
-- and a licence with no author refuses by its own name --
  note:     MIT names a copyright holder — fill in Author
-- filled in properly, Create makes the project --
  action:   project-created
  window:   false (closed on success)
  projects: 2
-- Close Project, which had no toolbar button at all --
  action: project-closed | closed (project) — the folder is untouched
  projects: 1
