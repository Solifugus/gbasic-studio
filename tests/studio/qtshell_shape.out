== the window, cold ==
window studio
  menu "Project"
    item mi_new_project
    item mi_open_folder
    separator
    item mi_project_file
    item mi_close_project
  menu "File"
    item mi_new_file
    item mi_new_folder
    separator
    item mi_rename
    item mi_delete
    separator
    item mi_reload
    item mi_close_tab
  menu "Settings"
    item mi_theme_system
    item mi_theme_dark
    separator
    item mi_text_bigger
    item mi_text_smaller
    item mi_text_reset
    separator
    item mi_restore_session
  popup nav_menu
    item ctx_open
    item ctx_new_file_here
    item ctx_new_folder_here
    item ctx_rename
    item ctx_delete
    item ctx_project_file
    item ctx_close_project
  popup tab_menu
    item tabm_tab_close
    item tabm_tab_copy_path
  toolbar toolbar
    item save
    item tb_reload
    separator
    item tb_open_folder
    item tb_new_file
    item tb_new_folder
  docks left
    dock dock_files "Files"
      tree files to show nav
        field text
        field depth
  docks bottom
    dock dock_console "Console"
      scroll console
        column
          row
            button run_btn
            button run_all_btn
            button stop_btn
            button snippet_btn
            button schema_btn
            text run_section
            text run_standing
            stretch
          text run_state
          text run_branch
          separator
          text prefix_head
          memo prefix_body
          separator
          text target_head
          memo target_body
          separator
          text err_head
          memo err_body
  docks right
    dock dock_branch "Branches"
      table branch_list to show branches
        field line
    dock dock_results "For the section at the cursor"
      memo results_body
    dock dock_tables "Tables"
      memo tables_body
    dock dock_git "Git"
      memo git_body
    dock dock_agent "Assistant"
      memo agent_body
  status
    text status
  column
    row
      field name_field
      stretch
    tabs book
      tab page_welcome "(no document)"
        column
          text welcome
          stretch
== and every option in it ==
  /studio                                             height=800 title=gBASIC Studio — ws width=1200
  /studio/mi_new_project                              label=New Project… toolTip=Open the New Project window: name it, choose where it goes, and pick what to create.
  /studio/mi_open_folder                              label=Open Folder toolTip=Open a folder you already have as a project. Type its path in the name field first; ~/ and relative paths work.
  /studio/mi_project_file                             label=Add Project File toolTip=Write a .gstudio.json in this project: a stable id so its saved state survives the folder moving, plus a place to list what the browser should hide and pin which gBASIC it runs under. Studio never creates this on its own.
  /studio/mi_close_project                            label=Close Project toolTip=Take this project out of the workspace and close its tabs. The folder is untouched and Open Folder puts it back.
  /studio/mi_new_file                                 label=New File shortcut=Ctrl+N toolTip=Create a file named by the header field — in the selected folder, the folder holding the selected file, or the project root.
  /studio/mi_new_folder                               label=New Folder toolTip=Create a folder named by the header field — in the selected folder, the folder holding the selected file, or the project root.
  /studio/mi_rename                                   label=Rename Selected toolTip=Rename the selected file or folder to what the header field says.
  /studio/mi_delete                                   label=Delete Selected toolTip=Delete the selected file or folder from disk. Press it twice: the first press arms it.
  /studio/mi_reload                                   label=Reload Changed Files toolTip=Check every open document against the file on disk: re-read the ones you have not edited, and flag the ones you have as conflicts. Nothing you typed is discarded.
  /studio/mi_close_tab                                label=Close Tab shortcut=Ctrl+W toolTip=Close the active document's tab. Unsaved text is discarded, so press it twice — the first press arms it.
  /studio/mi_theme_system                             checkable=true checked=true label=Follow the desktop toolTip=Follow your desktop: Studio adds nothing and looks like the rest of your system.
  /studio/mi_theme_dark                               checkable=true checked=false label=Dark toolTip=Studio's own dark look — the whole window, not just the editor — whatever your desktop is set to. Takes effect at once.
  /studio/mi_text_bigger                              label=Bigger editor text shortcut=Ctrl++ toolTip=Enlarge the code, and only the code. Ctrl and the mouse wheel do the same. The rest of the window follows your desktop's font setting.
  /studio/mi_text_smaller                             label=Smaller editor text shortcut=Ctrl+- toolTip=Shrink the code, and only the code. Ctrl and the mouse wheel do the same.
  /studio/mi_text_reset                               label=Reset editor text size shortcut=Ctrl+0 toolTip=Back to the size your desktop's font setting gives.
  /studio/mi_restore_session                          checkable=true checked=true label=Reopen last session on start toolTip=Whether Studio reopens the projects and files you had open. Read when Studio starts, so it takes effect on the next launch.
  /studio/nav_menu/ctx_open                           label=Open
  /studio/nav_menu/ctx_new_file_here                  label=New File here
  /studio/nav_menu/ctx_new_folder_here                label=New Folder here
  /studio/nav_menu/ctx_rename                         label=Rename…
  /studio/nav_menu/ctx_delete                         label=Delete
  /studio/nav_menu/ctx_project_file                   label=Add project file
  /studio/nav_menu/ctx_close_project                  label=Close project
  /studio/tab_menu/tabm_tab_close                     label=Close
  /studio/tab_menu/tabm_tab_copy_path                 label=Copy file path
  /studio/toolbar/save                                icon=SP_DialogSaveButton label=Save toolTip=Write the active document to disk. Over a file that changed underneath, press twice — the first press arms it.
  /studio/toolbar/tb_reload                           icon=SP_BrowserReload label=Reload toolTip=Check every open document against the file on disk: re-read the ones you have not edited, and flag the ones you have as conflicts. Nothing you typed is discarded.
  /studio/toolbar/tb_open_folder                      icon=SP_DialogOpenButton label=Open Folder toolTip=Open a folder you already have as a project. Type its path in the name field first; ~/ and relative paths work.
  /studio/toolbar/tb_new_file                         icon=SP_FileIcon label=New File toolTip=Create a file named by the header field — in the selected folder, the folder holding the selected file, or the project root.
  /studio/toolbar/tb_new_folder                       icon=SP_FileDialogNewFolder label=New Folder toolTip=Create a folder named by the header field — in the selected folder, the folder holding the selected file, or the project root.
  /studio/left/dock_files/files/text                  label=File
  /studio/left/dock_files/files/depth                 depth=true
  /studio/bottom/dock_console/console                 margin=6 spacing=6
  /studio/bottom/dock_console/console                 margin=0 spacing=6
  /studio/bottom/dock_console/console/run_btn         label=Run Section
  /studio/bottom/dock_console/console/run_all_btn     label=Run All
  /studio/bottom/dock_console/console/stop_btn        label=Stop
  /studio/bottom/dock_console/console/snippet_btn     label=Insert SQL…
  /studio/bottom/dock_console/console/schema_btn      label=Schema…
  /studio/bottom/dock_console/console/run_section     label=section: (none)
  /studio/bottom/dock_console/console/run_standing    label=
  /studio/bottom/dock_console/console/run_state       label=
  /studio/bottom/dock_console/console/run_branch      label=
  /studio/bottom/dock_console/console/prefix_head     label=Prefix output — sections replayed before the target
  /studio/bottom/dock_console/console/target_head     label=Target output — the section you ran
  /studio/bottom/dock_console/console/err_head        label=Errors
  /studio/right/dock_branch/branch_list/line          label=Branch
  /studio/status                                      label=ready — ws — 1 project(s) — 0 open
  /studio                                             margin=0 spacing=0
  /studio                                             margin=6 spacing=6
  /studio/name_field                                  placeholderText=name or path toolTip=A name for New File / New Folder / Rename, or a folder path for Open Folder (~ works). New Project asks for its own.
  /studio/book/page_welcome                           margin=12 spacing=6
  /studio/book/page_welcome/welcome                   label=Open a file from the browser, or File ▸ New File.
== every name it declares ==
  mi_new_project mi_open_folder mi_project_file mi_close_project mi_new_file mi_new_folder mi_rename mi_delete mi_reload mi_close_tab mi_theme_system mi_theme_dark mi_text_bigger mi_text_smaller mi_text_reset mi_restore_session nav_menu ctx_open ctx_new_file_here ctx_new_folder_here ctx_rename ctx_delete ctx_project_file ctx_close_project tab_menu tabm_tab_close tabm_tab_copy_path toolbar save tb_reload tb_open_folder tb_new_file tb_new_folder dock_files files text depth dock_console console run_btn run_all_btn stop_btn snippet_btn schema_btn run_section run_standing run_state run_branch prefix_head prefix_body target_head target_body err_head err_body dock_branch branch_list dock_results results_body dock_tables tables_body dock_git git_body dock_agent agent_body status name_field book page_welcome welcome
== the title carries the marker too, which is conventional ==
  cold: gBASIC Studio — ws
== and where the record puts each dock, before any window exists ==
  dock_files      left
  dock_console    bottom
  dock_branch     right
  dock_results    right
  dock_tables     right
  dock_git        right
  dock_agent      right
