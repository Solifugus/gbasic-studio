===== launch 1 =====
-- the home as it arrived --
  workspace present:  true
  documents restored: 0
-- the window, built from that model --
  opened:   true
  tabs:     ["(no document)"]
  title:    gBASIC Studio — workspace
  rows:     6
-- with main.bas open --
  action:   open
  tabs:     ["main.bas"]
  gutter:   true
  language: gBASIC
-- the application's own sheet --
  setting:      system
  dark applied: false
  after Dark:   theme-set — dark — open editors were rebuilt, so their undo history starts again
  sheet set:    true
  it is OURS:   true
  editor would be built: dark
  toolbar style:        ToolButtonIconOnly
  every toolbar icon arrived: true
  after the rebuild, the editor still holds its text: true
  ... its margin:    true
  ... its language:  gBASIC
-- and Follow the desktop puts it all back --
  action:        theme-set
  sheet cleared: true
  toolbar style: ToolButtonIconOnly
  every icon arrived: true
  editor built:  light
  and back to dark for the next launch: theme-set
  persisted:    true
===== launch 2 =====
-- the home as it arrived --
  workspace present:  true
  documents restored: 1
-- the window, built from that model --
  opened:   true
  tabs:     ["main.bas"]
  title:    main.bas — gBASIC Studio — workspace
  rows:     6
-- with main.bas open --
  action:   open
  tabs:     ["main.bas"]
  gutter:   true
  language: gBASIC
-- the application's own sheet --
  setting:      dark
  dark applied: true
  after Dark:   theme-same — dark
  sheet set:    true
  it is OURS:   true
  editor would be built: dark
  toolbar style:        ToolButtonIconOnly
  every toolbar icon arrived: true
  after the rebuild, the editor still holds its text: true
  ... its margin:    true
  ... its language:  gBASIC
-- and Follow the desktop puts it all back --
  action:        theme-set
  sheet cleared: true
  toolbar style: ToolButtonIconOnly
  every icon arrived: true
  editor built:  light
  and back to dark for the next launch: theme-set
  persisted:    true
