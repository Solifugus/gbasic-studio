== a semicolon inside a string is not a terminator ==
  0: insert - [write] 1:1-1:30
     <insert into t values ('a;b');>
  1: select - [read] 2:1-2:10
     <select 1;>
== nor inside a doubled-quote escape ==
  0: insert - [write] 1:1-1:38
     <insert into t values ('it''s; fine');>
  1: select - [read] 2:1-2:10
     <select 2;>
== nor inside a line comment ==
  0: select - [read] 1:1-1:10
     <select 1;>
  1: select - [read] 2:1-2:10
     <select 2;>
== nor inside a block comment, which PostgreSQL NESTS ==
  0: select - [read] 2:1-2:10
     <select 1;>
== nor inside a quoted identifier, in any of the three spellings ==
  0: select - [read] 1:1-1:21
     <select "a;b" from t;>
  1: select - [read] 2:1-2:21
     <select `c;d` from t;>
  2: select - [read] 3:1-3:21
     <select [e;f] from t;>
== nor inside a dollar-quoted body ==
  0: create f [write] 1:1-1:79
     <create function f() returns int as $$ begin return 1; end $$ language plpgsql;>
  1: select - [read] 2:1-2:10
     <select 1;>
== nor inside a TAGGED dollar-quoted body ==
  0: create f [write] 1:1-1:73
     <create function f() returns int as $body$ select 1; $body$ language sql;>
  1: select - [read] 2:1-2:10
     <select 2;>
== but $1 is a parameter and opens nothing ==
  0: select - [read] 1:1-1:31
     <select * from t where id = $1;>
  1: select - [read] 2:1-2:10
     <select 2;>
