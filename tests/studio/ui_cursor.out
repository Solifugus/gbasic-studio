== which section each caret position is in (editor 0-based lines) ==
  line 0 -> sec-1   | section: sec-1 statements
  line 1 -> sec-1   | section: sec-1 statements
  line 2 -> sec-2   | section: sec-2 function add
  line 3 -> sec-2   | section: sec-2 function add
  line 4 -> sec-2   | section: sec-2 function add
  line 5 -> sec-2   | section: sec-2 function add
  line 6 -> sec-3   | section: sec-3 statements
  line 7 -> sec-3   | section: sec-3 statements
